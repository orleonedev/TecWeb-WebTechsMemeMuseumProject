


datasource db {

  provider = "sqlite"

  url      = env("DATABASE_URL")

}



generator client {

  provider = "prisma-client-js"

  binaryTargets = ["native", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x"]

}



model User {

  id        Int       @id @default(autoincrement())

  email     String    @unique

  password  String    // Hashed

  username  String

  memes     Meme[]

  comments  Comment[]

  votes     Vote[]

}



model Meme {

  id          Int       @id @default(autoincrement())

  title       String

  imageUrl    String    // Path to local file (e.g., /uploads/meme-1.jpg)

  description String?

    createdAt   DateTime  @default(now())

    score       Int       @default(0) // Sum of votes

    userId      Int

    user        User      @relation(fields: [userId], references: [id])

  comments    Comment[]

  votes     Vote[]

  tags        Tag[]

}



model Tag {

  id    Int    @id @default(autoincrement())

  name  String @unique // e.g., "Funny", "Cats"

  memes Meme[]

}



model Vote {

  id     Int    @id @default(autoincrement())

  value  Int    // 1 for upvote, -1 for downvote

  userId Int

  memeId Int

  user   User   @relation(fields: [userId], references: [id])

  meme   Meme   @relation(fields: [memeId], references: [id])



  @@unique([userId, memeId]) // One vote per user per meme

}



model Comment {

  id        Int      @id @default(autoincrement())

  text      String

  createdAt DateTime @default(now())

  userId    Int

  memeId    Int

  user      User     @relation(fields: [userId], references: [id])

  meme      Meme     @relation(fields: [memeId], references: [id])

}


